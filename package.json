{
  "name": "playtopiaapppro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.js",
    "start": "cross-env APP_VARIANT=development NODE_ENV=development expo start",
    "start:tunnel": "cross-env APP_VARIANT=development NODE_ENV=development expo start --tunnel",
    "start:local": "cross-env APP_VARIANT=development NODE_ENV=development expo start --lan",
    "start:prod": "cross-env APP_VARIANT=production NODE_ENV=production expo start",
    "start:tunnel:prod": "cross-env APP_VARIANT=production NODE_ENV=production expo start --tunnel",
    "android": "cross-env APP_VARIANT=development expo run:android",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p __tests__",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eas:update:preview": "eas update --channel preview --environment preview",
    "eas:update:production": "eas update --channel production --environment production",
    "verificar:ota": "node scripts/verify-ota.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@playtopia/icons": "1.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "crypto-js": "4.2.0",
    "dayjs": "^1.11.23",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "26.6.2",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@11.27.1"
}
