{
  "name": "playtopiaapppro",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.js",
    "start": "cross-env APP_VARIANT=development NODE_ENV=development expo start",
    "start:tunnel": "cross-env APP_VARIANT=development NODE_ENV=development expo start --tunnel",
    "start:local": "cross-env APP_VARIANT=development NODE_ENV=development expo start --lan",
    "start:prod": "cross-env APP_VARIANT=production NODE_ENV=production expo start",
    "start:tunnel:prod": "cross-env APP_VARIANT=production NODE_ENV=production expo start --tunnel",
    "android": "cross-env APP_VARIANT=development expo run:android",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p __tests__",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@11.27.1"
}
