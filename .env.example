# ===========================================
# PLAYTOPIA PRO - VARIABLES DE ENTORNO
# ===========================================
# Copia este fichero a .env y rellena los valores. .env nunca se sube al repo.
# En los builds, los valores salen de las variables de EAS de cada entorno.
#
# Todo lo que empieza por EXPO_PUBLIC_ se incrusta en el bundle y se puede
# leer desde la app instalada: aquí solo van valores públicos. Los secretos
# de verdad (token de Sentry, credenciales de tiendas) viven solo en EAS.
# Las variables se validan al arrancar en src/shared/config/env.ts.

# API de Core (servidor de desarrollo). Scalar: https://core-dev.playtopiax.com/docs
EXPO_PUBLIC_API_BASE_URL=https://core-dev.playtopiax.com/api

# Firma HMAC del registro (registration_token de POST /api/UserTeacher).
# Core valida el alta de alumno y la de profesor con el mismo secreto
# (backend_shared_secret): es el mismo valor que EXPO_PUBLIC_USER_STUDENT_SHARED_SECRET
# de la app de alumnos. Pídelo al equipo; no lo escribas aquí.
EXPO_PUBLIC_USER_TEACHER_SHARED_SECRET=

# Tolerancia en segundos entre el reloj del móvil y el del servidor para la firma.
EXPO_PUBLIC_TOKEN_SKEW_SECONDS=300

# DSN de Sentry (público por diseño). Vacío = Sentry desactivado.
EXPO_PUBLIC_SENTRY_DSN=
